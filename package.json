{
  "name": "wisp-ampdeck",
  "version": "0.1.0",
  "description": "A standalone Linux and macOS desktop music player.",
  "main": "electron/main.cjs",
  "desktopName": "wisp-ampdeck",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "skin:build": "bash scripts/build-wisp-skin.sh",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux && bash scripts/build-linux-release.sh",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "build": {
    "appId": "org.wisp.ampdeck",
    "productName": "Wisp AmpDeck",
    "files": [
      "dist/index.html",
      "dist/assets/**/*",
      "dist/skins/**/*",
      "electron/**/*",
      "package.json",
      "NOTICE.txt"
    ],
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "synopsis": "A standalone desktop music player.",
      "syncDesktopName": true,
      "category": "AudioVideo;Audio"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "vite": "latest",
    "wait-on": "latest"
  },
  "dependencies": {
    "music-metadata": "^11.15.0",
    "webamp": "^2.3.1"
  }
}
